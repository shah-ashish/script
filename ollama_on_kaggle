
#!/usr/bin/env bash
set -Eeuo pipefail

# Usage: ./setup-ollama.sh <model-name>

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <model-name>"
    exit 1
fi

MODEL="$1"
API_KEY="sk-ollama-$(python3 -c "import secrets; print(secrets.token_hex(16))" 2>/dev/null || echo "$RANDOM$RANDOM")"

# Check dependencies
for cmd in curl grep; do
    command -v "$cmd" >/dev/null || {
        echo "Missing dependency: $cmd"
        exit 1
    }
done

SUDO=""
if [[ $EUID -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
fi

# Ensure zstd and pciutils (for GPU detection) are installed
PKGS_TO_INSTALL=()
command -v zstd >/dev/null 2>&1 || PKGS_TO_INSTALL+=("zstd")
command -v lspci >/dev/null 2>&1 || PKGS_TO_INSTALL+=("pciutils")

if [[ ${#PKGS_TO_INSTALL[@]} -gt 0 ]]; then
    echo "Installing missing dependencies: ${PKGS_TO_INSTALL[*]}..."
    if command -v apt-get >/dev/null 2>&1; then
        $SUDO apt-get update -y && $SUDO apt-get install -y "${PKGS_TO_INSTALL[@]}"
    elif command -v dnf >/dev/null 2>&1; then
        $SUDO dnf install -y "${PKGS_TO_INSTALL[@]}"
    elif command -v pacman >/dev/null 2>&1; then
        $SUDO pacman -Sy --noconfirm "${PKGS_TO_INSTALL[@]}"
    elif command -v apk >/dev/null 2>&1; then
        apk add "${PKGS_TO_INSTALL[@]}"
    fi
fi

echo "[1/5] Installing Ollama..."

if ! command -v ollama >/dev/null 2>&1; then
    curl -fsSL https://ollama.com/install.sh | sh
fi

echo "[2/5] Starting Ollama..."

export OLLAMA_HOST="0.0.0.0:11434"
export OLLAMA_ORIGINS="*"

# If already running, restart to ensure environment variables are applied
if pgrep -x ollama >/dev/null; then
    echo "Restarting Ollama to apply remote access settings..."
    pkill -x ollama 2>/dev/null || true
    sleep 1
fi

START_VIA_SYSTEMD=false
if [[ -d /run/systemd/system ]] && command -v systemctl >/dev/null 2>&1; then
    if systemctl is-system-running >/dev/null 2>&1 || [[ "$(systemctl is-system-running 2>/dev/null || true)" =~ (running|degraded) ]]; then
        START_VIA_SYSTEMD=true
    fi
fi

if [[ "$START_VIA_SYSTEMD" == "true" ]] && systemctl list-unit-files ollama.service --no-legend 2>/dev/null | grep -q ollama; then
    $SUDO systemctl enable --now ollama || {
        echo "systemd service start failed, falling back to background process..."
        if ! pgrep -x ollama >/dev/null; then
            ollama serve >/tmp/ollama.log 2>&1 &
        fi
    }
else
    if ! pgrep -x ollama >/dev/null; then
        ollama serve >/tmp/ollama.log 2>&1 &
    fi
fi

# Wait for Ollama API
for i in {1..60}; do
    if curl -fsS http://127.0.0.1:11434/api/tags >/dev/null; then
        break
    fi
    sleep 2
done

curl -fsS http://127.0.0.1:11434/api/tags >/dev/null || {
    echo "Ollama failed to start. Service logs:"
    cat /tmp/ollama.log 2>/dev/null || true
    exit 1
}

echo "[3/5] Pulling model: $MODEL"

if command -v python3 >/dev/null 2>&1; then
    python3 - <<EOF "$MODEL"
import sys, json, urllib.request

model = sys.argv[1]
url = "http://127.0.0.1:11434/api/pull"
data = json.dumps({"name": model, "stream": True}).encode("utf-8")
req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})

try:
    with urllib.request.urlopen(req) as resp:
        for raw_line in resp:
            line = raw_line.decode("utf-8").strip()
            if not line:
                continue
            val = json.loads(line)
            if "error" in val:
                sys.stderr.write(f"\nError: {val['error']}\n")
                sys.exit(1)
            status = val.get("status", "")
            completed = val.get("completed", 0)
            total = val.get("total", 0)
            if total > 0:
                pct = int((completed / total) * 100)
                gb_done = completed / (1024**3)
                gb_tot = total / (1024**3)
                bar_len = 20
                filled = int(bar_len * completed // total)
                bar = "=" * filled + "-" * (bar_len - filled)
                msg = f"\r[3/5] {status}: [{bar}] {pct}% ({gb_done:.2f}/{gb_tot:.2f} GB)"
            else:
                msg = f"\r[3/5] {status}"
            sys.stdout.write(msg.ljust(80)[:80])
            sys.stdout.flush()
    print(f"\n[3/5] Successfully pulled {model}")
except KeyboardInterrupt:
    sys.exit(130)
except Exception as e:
    sys.stderr.write(f"\nFailed to pull model: {e}\n")
    sys.exit(1)
EOF
else
    ollama pull "$MODEL"
fi

echo "[4/5] Installing cloudflared..."

if ! command -v cloudflared >/dev/null 2>&1; then
    ARCH="$(uname -m)"

    case "$ARCH" in
        x86_64) CF_ARCH="amd64" ;;
        aarch64|arm64) CF_ARCH="arm64" ;;
        *)
            echo "Unsupported architecture: $ARCH"
            exit 1
            ;;
    esac

    $SUDO curl -fL \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CF_ARCH}" \
        -o /usr/local/bin/cloudflared

    $SUDO chmod +x /usr/local/bin/cloudflared
fi

echo "[5/5] Starting Auth Proxy & Cloudflare Tunnel..."

pkill -f "ollama_proxy.py" 2>/dev/null || true
pkill -x cloudflared 2>/dev/null || true

PROXY_SCRIPT="/tmp/ollama_proxy.py"
cat <<'EOF' > "$PROXY_SCRIPT"
import sys, http.server, socketserver, urllib.request, urllib.error, urllib.parse

PORT = int(sys.argv[1])
TARGET_PORT = int(sys.argv[2])
EXPECTED_KEY = sys.argv[3]

class ThreadedHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True

class AuthProxyHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, format, *args):
        pass

    def check_auth(self):
        auth_header = self.headers.get('Authorization', '')
        x_api_key = self.headers.get('x-api-key', '')
        parsed = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(parsed.query)
        q_key = qs.get('api_key', [None])[0]

        token = None
        if auth_header.startswith('Bearer '):
            token = auth_header[7:].strip()
        elif x_api_key:
            token = x_api_key.strip()
        elif q_key:
            token = q_key.strip()

        return token == EXPECTED_KEY

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Authorization, Content-Type, x-api-key')
        self.send_header('Content-Length', '0')
        self.end_headers()

    def proxy(self):
        if not self.check_auth():
            self.send_response(401)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            msg = b'{"error": "Unauthorized: Invalid or missing API key"}\n'
            self.send_header('Content-Length', str(len(msg)))
            self.end_headers()
            self.wfile.write(msg)
            return

        target_url = f"http://127.0.0.1:{TARGET_PORT}{self.path}"
        content_len = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(content_len) if content_len > 0 else None

        req_headers = {}
        for k, v in self.headers.items():
            if k.lower() not in ('host', 'content-length', 'transfer-encoding', 'connection'):
                req_headers[k] = v

        req = urllib.request.Request(target_url, data=body, headers=req_headers, method=self.command)

        try:
            with urllib.request.urlopen(req) as resp:
                self.send_response(resp.status)
                for h, val in resp.getheaders():
                    if h.lower() not in ('transfer-encoding', 'connection'):
                        self.send_header(h, val)
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()

                while True:
                    chunk = resp.read(4096)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    self.wfile.flush()
        except urllib.error.HTTPError as e:
            self.send_response(e.code)
            for h, val in e.headers.items():
                if h.lower() not in ('transfer-encoding', 'connection'):
                    self.send_header(h, val)
            self.send_header('Access-Control-Allow-Origin', '*')
            self.end_headers()
            self.wfile.write(e.read())
            self.wfile.flush()
        except Exception as e:
            self.send_response(502)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.end_headers()
            self.wfile.write(f'{{"error": "Proxy error: {str(e)}"}}\n'.encode('utf-8'))

    do_GET = proxy
    do_POST = proxy
    do_PUT = proxy
    do_DELETE = proxy
    do_HEAD = proxy

with ThreadedHTTPServer(('127.0.0.1', PORT), AuthProxyHandler) as httpd:
    httpd.serve_forever()
EOF

python3 "$PROXY_SCRIPT" 11435 11434 "$API_KEY" >/tmp/proxy.log 2>&1 &
PROXY_PID=$!

LOG_FILE="$(mktemp)"
cloudflared tunnel --no-autoupdate \
    --http-host-header="localhost:11435" \
    --url http://127.0.0.1:11435 >"$LOG_FILE" 2>&1 &

TUNNEL_PID=$!

cleanup() {
    kill "$TUNNEL_PID" 2>/dev/null || true
    kill "$PROXY_PID" 2>/dev/null || true
    pkill -f "ollama_proxy.py" 2>/dev/null || true
    rm -f "$LOG_FILE" "$PROXY_SCRIPT"
}
trap cleanup EXIT INT TERM

# Wait for the public URL
PUBLIC_URL=""

for i in {1..60}; do
    PUBLIC_URL="$(grep -oE 'https://[a-zA-Z0-9-]+\.trycloudflare\.com' "$LOG_FILE" | head -n 1 || true)"

    if [[ -n "$PUBLIC_URL" ]]; then
        break
    fi

    if ! kill -0 "$TUNNEL_PID" 2>/dev/null; then
        cat "$LOG_FILE"
        echo "Cloudflare tunnel failed."
        exit 1
    fi

    sleep 2
done

if [[ -z "$PUBLIC_URL" ]]; then
    echo "Could not obtain Cloudflare URL."
    cat "$LOG_FILE"
    exit 1
fi

echo
echo "=========================================================="
echo " Ollama is SECURED with API Key & running!"
echo "=========================================================="
echo " Model:       $MODEL"
echo " Public URL:  $PUBLIC_URL"
echo " API Key:     $API_KEY"
echo "=========================================================="
echo " How to use your API Key:"
echo
echo " 1) Browser / Quick check:"
echo "    $PUBLIC_URL/?api_key=$API_KEY"
echo
echo " 2) cURL (Ollama API):"
echo "    curl -H \"Authorization: Bearer $API_KEY\" \\"
echo "         $PUBLIC_URL/api/tags"
echo
echo " 3) Python (OpenAI SDK / LangChain / Open WebUI):"
echo "    base_url = \"$PUBLIC_URL/v1\""
echo "    api_key  = \"$API_KEY\""
echo "=========================================================="
echo
echo "Keep this script running to keep the tunnel alive."
echo "Press Ctrl+C to stop."

wait "$TUNNEL_PID"
